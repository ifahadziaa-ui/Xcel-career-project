# Candidate accounts (sign-in, applications, saved roles). All optional: without the first two the site
# works as before and the sign-in pages say accounts are not on yet.

# A Postgres connection string (Vercel Postgres / Neon, Supabase, or any Postgres).
DATABASE_URL=

# Signs the session cookie. Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# The public address of the site (used for sign-in redirects). Not needed on Vercel production.
BETTER_AUTH_URL=http://localhost:3000

# "Continue with Google" (appears only when both are set).
# Redirect URI to register in Google Cloud: <site address>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# At launch
NEXT_PUBLIC_INDEXABLE=
NEXT_PUBLIC_SITE_URL=
